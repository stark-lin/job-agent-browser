{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": ".cache/tests",
    "baseUrl": ".",
    "paths": {},
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/database/**/*.ts",
    "src/platform/storage/**/*.ts",
    "src/platform/electron/**/*.ts",
    "src/shared/ipc.ts",
    "tests/**/*.ts",
    "src/platform/browser/**/*.ts",
    "src/shared/browser.ts",
    "src/shared/navigation.ts",
    "src/app/navigation/navigationStore.ts",
    "src/app/context/contextStore.ts",
    "src/shared/i18n/**/*.ts"
  ]
}
