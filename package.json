{
  "name": "job-agent-browser",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-native desktop browser foundation for Job Agent Browser.",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.cjs",
    "quality": "node scripts/quality.cjs",
    "test:smoke": "npm run build && node scripts/run-smoke.cjs",
    "check": "npm run typecheck && npm run quality && npm test && npm run build"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
